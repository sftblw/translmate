{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-warning-comments": [
      "warn",
      {
        "terms": ["fixme", "todo"],
        "location": "start"
      }
    ]
  },
  "ignorePatterns": ["sidebar-next/**", ".wxt/**", ".output/**", "output/**"]
}
